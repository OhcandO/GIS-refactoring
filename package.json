{
  "name": "gis-refactoring",
  "version": "1.0.0",
  "description": "MindOne GIS Openlayers 라이브러리 최적 사용을 위한 JS 모듈화 프로젝트.\r 지도가 필요한 화면에 간단하게 적용하여, \"미리 설정한 스타일의\" 지도 화면과 상호작용을 제공하도록 함.",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "webpack --progress",
    "build:examples": "webpack --progress && node -e \"require('fs').cpSync('dist/main.js','docs/examples/js/mogismap.js')\"",
    "typecheck": "tsc --noEmit",
    "docs": "typedoc src/index.ts",
    "build:all": "npm run build:examples && npm run docs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/proj4": "^2.5.6",
    "ts-loader": "^9.5.4",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.2",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OhcandO/GIS-refactoring.git"
  },
  "bugs": {
    "url": "https://github.com/OhcandO/GIS-refactoring/issues"
  },
  "homepage": "https://github.com/OhcandO/GIS-refactoring#readme",
  "dependencies": {
    "@simonwep/pickr": "^1.9.0",
    "ol": "^7.5.1",
    "proj4": "^2.9.2",
    "spin.js": "^4.1.2"
  }
}
